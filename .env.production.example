# Copy to /home/<deploy-user>/yv-chat/.env, replace every placeholder there,
# then chmod 600. Never commit the populated production file.
POSTGRES_DB=yv_chat
POSTGRES_USER=yv_chat
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-32
DATABASE_URL=postgresql+asyncpg://yv_chat:same-hex-value@postgres:5432/yv_chat
ALLOWED_ORIGINS=["https://chat.yoowee.ru"]
TRUSTED_PROXY_CIDRS=["172.30.242.10/32"]
YV_CHAT_BIND_PORT=18080

ACTIVATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
SESSION_IDLE_TIMEOUT_SECONDS=2592000
SESSION_ABSOLUTE_LIFETIME_SECONDS=7776000
SESSION_ROTATION_INTERVAL_SECONDS=86400
SESSION_PREVIOUS_TOKEN_GRACE_SECONDS=60
SESSION_TOUCH_INTERVAL_SECONDS=300
SECURITY_EVENT_RETENTION_SECONDS=7776000
SYNC_EVENT_RETENTION_SECONDS=2592000
MESSAGE_CIPHERTEXT_RETENTION_SECONDS=2592000
MESSAGE_TOMBSTONE_RETENTION_SECONDS=7776000
MESSAGE_CLEANUP_BATCH_SIZE=200
MESSAGE_CLEANUP_INTERVAL_SECONDS=300
MEDIA_IMAGE_MAX_BYTES=12582912
MEDIA_VIDEO_MAX_BYTES=104857600
MEDIA_FILE_MAX_BYTES=26214400
MEDIA_USER_QUOTA_BYTES=157286400
MEDIA_PENDING_RETENTION_SECONDS=86400
MEDIA_CLEANUP_BATCH_SIZE=100
